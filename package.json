{
  "name": "shorten-url-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'npm:dev:worker' 'npm:dev:web'",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite --host 0.0.0.0",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "npm run cf-typegen && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && npm test",
    "format": "prettier --write src tests admin *.json *.ts wrangler.jsonc README.md .github/workflows/ci.yml"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.0.0"
  }
}
