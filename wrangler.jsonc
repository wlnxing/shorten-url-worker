{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorten-url-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/s", "/s/*", "/api/*"],
  },
  "vars": {
    "MODE": "detailed",
    "STATS_RETENTION_DAYS": "180",
    "ARCHIVE_BATCH_SIZE": "500",
    "ARCHIVE_MAX_KB": "512",
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "SESSION_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shorten-url",
      // 一键部署会自动替换；手动部署时填写自己账号的数据库 ID。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ARCHIVES", "bucket_name": "shorten-url-archives" }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": { "crons": ["*/20 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
